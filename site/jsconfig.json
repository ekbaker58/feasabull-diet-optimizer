{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@solver/*": [
        "../src/lib/*"
      ]
    },
    "checkJs": false
  },
  "include": [
    "src/**/*"
  ]
}
